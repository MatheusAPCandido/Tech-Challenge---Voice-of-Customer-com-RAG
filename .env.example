# Copie este arquivo para .env e preencha. O .env NÃO vai para o GitHub.

# true = interface e pipeline usam dados falsos (útil enquanto a base não está pronta)
USE_MOCK=true

# Modelos
EMBEDDING_MODEL=intfloat/multilingual-e5-base
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# Chaves de API (deixe vazio se não usar)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Recuperação
TOP_K_CANDIDATOS=40
TOP_K_FINAL=10
LIMIAR_RELEVANCIA=0.5
MIN_EVIDENCIAS=3
