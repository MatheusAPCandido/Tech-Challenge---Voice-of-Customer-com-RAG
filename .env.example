# Copie este arquivo para .env e preencha. O .env NÃO vai para o GitHub.

# true = interface e pipeline usam dados falsos (útil enquanto a base não está pronta)
USE_MOCK=true

# Modelos
EMBEDDING_MODEL=intfloat/multilingual-e5-base
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# T11b / T21: ollama | openai | anthropic
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_TIMEOUT_S=5

# Chaves de API (deixe vazio se não usar OpenAI/Anthropic)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Recuperação
TOP_K_CANDIDATOS=40
TOP_K_FINAL=10
LIMIAR_RELEVANCIA=0.5
MIN_EVIDENCIAS=3
