# Copie este arquivo para .env e preencha. O .env NÃO vai para o GitHub.

# true = interface e pipeline usam dados falsos (útil enquanto a base não está pronta)
USE_MOCK=true

# Modelos
EMBEDDING_MODEL=intfloat/multilingual-e5-base
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# T11 (transformação da pergunta): regras | ollama
# "regras" foi a configuração da avaliação final (T28) e da demonstração.
# "ollama" pede um JSON ao LLM_MODEL e volta para as regras se ele falhar.
LLM_PROVIDER=regras
LLM_MODEL=qwen2.5
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_TIMEOUT_S=5

# Recuperação
TOP_K_CANDIDATOS=40
TOP_K_FINAL=10
LIMIAR_RELEVANCIA=0.5
MIN_EVIDENCIAS=3

# Gate de suficiência pós-limiar (Ollama). Default off — não muda o T16 sem daemon.
# true = após score>=LIMIAR, Ollama decide se as evidências respondem à pergunta (ex. P09 drone).
# Usa OLLAMA_HOST + LLM_MODEL (mesmo client da T11). Não é geração Gemini nem métricas T17.
# Se o smoke do judge estourar timeout, suba OLLAMA_TIMEOUT_S (ex. 30) só no .env.
JUDGE_ENABLED=false

# Geração — Gemini por API. Crie a chave em https://aistudio.google.com
GEN_PROVIDER=gemini
GEN_MODEL=gemini-3.5-flash
GOOGLE_API_KEY=
# GEN_MOCK: se omitido, segue USE_MOCK.
# Para testar geração real com busca mock, descomente:
# GEN_MOCK=false

# Reserva: se o Gemini falhar (sem chave, 503, timeout), tenta este modelo no Ollama.
# Deixe vazio para desligar (e na avaliação T17b/T28). Só Ollama: GEN_PROVIDER=ollama e GEN_MODEL=qwen2.5
GEN_FALLBACK_MODEL=qwen2.5
GEN_OLLAMA_TIMEOUT_S=120

# T17b (exemplo — fidelidade manual com um único modelo local):
# USE_MOCK=false
# GEN_MOCK=false
# GEN_PROVIDER=ollama
# GEN_MODEL=qwen2.5
# GEN_FALLBACK_MODEL=
# JUDGE_ENABLED=false
# HF_HUB_OFFLINE=1